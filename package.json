{
  "name": "cadmus-graph-studio-app",
  "version": "2.0.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check-libs": "node scripts/check-local-libs.js",
    "build:libs": "node scripts/build-libs.mjs",
    "test:lib": "ng test @myrmidon/cadmus-mapping-builder --watch=false",
    "test:app": "ng test cadmus-graph-studio-app --watch=false",
    "test:all": "pnpm run test:lib && pnpm run test:app",
    "test:coverage": "ng test @myrmidon/cadmus-mapping-builder --watch=false --coverage && ng test cadmus-graph-studio-app --watch=false --coverage"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/localize": "^22.2.4",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@jean-merelis/ngx-monaco-editor": "^21.0.0",
    "@myrmidon/ngx-mat-tools": "^3.0.1",
    "@myrmidon/ngx-tools": "^3.0.2",
    "@myrmidon/paged-data-browsers": "^6.0.1",
    "monaco-editor": "^0.47.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.67.5"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
